# VelChat dev flavor — PUBLIC build config only (never secrets).
# Uses localhost + `adb reverse` so it works on BOTH a USB device and an emulator:
#   adb reverse tcp:8081 tcp:8081   (Metro — run-android sets this up automatically)
#   adb reverse tcp:8080 tcp:8080   (backend gateway — run manually when the backend is up, MP1+)
# The backend dev gateway runs at http://localhost:8080 (docs/backend-integration-reference.md).
ENV=dev
API_BASE_URL=http://localhost:8080
WS_URL=ws://localhost:8080/ws

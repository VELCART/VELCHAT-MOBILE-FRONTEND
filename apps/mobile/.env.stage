# VelChat stage flavor — PUBLIC build config only (never secrets).
# NOTE: prod/stage backends are per-service on Render (no single origin) — these
# are placeholders until the ingress host strategy is confirmed with the backend team.
ENV=stage
# REST → the api-gateway aggregator (routes /auth,/users,… to each service).
API_BASE_URL=https://velchat-api-gateway.onrender.com
# WebSocket → the realtime-gateway is its own Render host (NOT proxied by api-gateway).
WS_URL=wss://velchat-realtime-gateway.onrender.com/ws
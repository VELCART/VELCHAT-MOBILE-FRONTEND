# React Native + pnpm monorepo: a flat, hoisted node_modules is the most
# compatible layout for RN autolinking (Gradle) and Metro resolution.
node-linker=hoisted
# RN's dependency graph has many loose/legacy peer ranges; don't fail installs on them.
strict-peer-dependencies=false
auto-install-peers=true
# Keep the store on the same drive for speed on Windows.
prefer-frozen-lockfile=false

# Resilience for slow / flaky networks (Windows). Serialize fetches (a weak
# connection completes a single stream faster than several split ones) with
# long timeouts + many retries to survive ECONNRESET / BROKEN_METADATA_JSON.
network-concurrency=1
child-concurrency=1
fetch-retries=10
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=300000
fetch-timeout=1200000
